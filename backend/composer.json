{
    "name": "nxtlabtech/doubtqueue",
    "description": "A simple doubt queue for mentor office hours.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DoubtQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DoubtQueue\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8000 -t public public/index.php"
        ],
        "test": "phpunit"
    }
}
